<?xml version="1.0" encoding="utf-8"?>
<!--
  Code coverage settings for Microsoft.Testing.Extensions.CodeCoverage,
  passed with the coverage-settings option of dotnet test (command in CLAUDE.md).
  Generated code is excluded so the numbers measure hand-written code only.
-->
<Configuration>
  <CodeCoverage>
    <Functions>
      <Exclude>
        <!-- EF Core migrations and model snapshot (generated by dotnet ef) -->
        <Function>^SoundRevival\.Infrastructure\.Migrations\..*</Function>
      </Exclude>
    </Functions>
  </CodeCoverage>
</Configuration>
